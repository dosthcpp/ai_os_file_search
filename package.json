{
  "name": "ai-os",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,indexer,web -c blue,green,magenta \"npm run api\" \"npm run indexer\" \"npm run web\"",
    "api": "python3 -m uvicorn main:app --app-dir apps/search_api --reload --port 8000",
    "indexer": "python3 -u packages/file-indexer/main.py",
    "web": "cd webapp && npm run dev",
    "install:api": "pip3 install -r apps/search_api/requirements.txt",
    "install:indexer": "pip3 install -r packages/file-indexer/requirements.txt",
    "install:web": "cd webapp && npm install",
    "install:all": "npm run install:api && npm run install:indexer && npm run install:web"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  },
  "dependencies": {
    "pdf-parse": "^2.4.5",
    "pdf2json": "^4.0.2",
    "puppeteer-core": "^24.40.0"
  }
}
